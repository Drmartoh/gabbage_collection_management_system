# GCMS - Copy to .env and adjust
DEBUG=True
SECRET_KEY=your-secret-key-here
# Generate a key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
ALLOWED_HOSTS=localhost,127.0.0.1
# PythonAnywhere example: gcmskarai.pythonanywhere.com

# Database (default: SQLite)
# DATABASE_URL=sqlite:///db.sqlite3
# For PostgreSQL:
# DATABASE_URL=psql://user:pass@localhost/gcms_db
# PythonAnywhere MySQL: mysql://user:pass@user.mysql.pythonanywhere-services.com/dbname

# SMS API (optional - leave empty to disable)
# GCMS_SMS_API_URL=https://api.sms-provider.com/send
# GCMS_SMS_API_KEY=your-api-key
# GCMS_SMS_SENDER_ID=GCMS

# HERE Maps (optional - for maps, geocoding, routing; leave empty to hide maps)
# Get key at https://platform.here.com/
# HERE_API_KEY=your-here-api-key
